{
  "id": "player-pro",
  "name": "Anirium Player Pro",
  "version": "1.0.0",
  "description": "Cliente de reprodução do Anirium Service: exibe as qualidades, áudios e legendas entregues pelo serviço. Também reproduz arquivos locais e links HTTP diretos.",
  "author": "Anirium Community & TGCode",
  "type": "official-plus",
  "origin": "official",
  "capabilities": [
    "ui.player.render",
    "ui.player.overlay",
    "playback.client",
    "subtitles.manage",
    "audio.manage"
  ],
  "uiEdits": [
    "ui.player.toolbar",
    "ui.player.overlay",
    "ui.player.controlBar"
  ],
  "display": [
    "media.video"
  ],
  "permissions": [
    "ui.player.render",
    "playback.client"
  ],
  "entrypoint": "src/addons/player-pro/PlayerProComponent.tsx",
  "enabled": true
}
